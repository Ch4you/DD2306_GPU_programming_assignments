if(MSVC AND CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
  function(add_qft_windows_compat)
    target_compile_options(QuEST PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/utf-8>")
    if(TARGET qft_naive)
      target_compile_options(qft_naive PRIVATE "/FI${QFT_WINDOWS_COMPAT}")
    endif()
  endfunction()
  cmake_language(DEFER CALL add_qft_windows_compat)
endif()
